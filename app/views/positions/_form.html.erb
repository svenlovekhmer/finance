<%= form_with model: [ portfolio, position ], class: "form" do |form| %>
  <% if position.errors.any? %>
    <div class="error-summary">
      <strong><%= pluralize(position.errors.count, "erreur") %> à corriger :</strong>
      <ul>
        <% position.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="asset-search" data-controller="asset-search" data-asset-search-url-value="<%= market_data_search_path %>">
    <div class="field">
      <%= form.label :asset_name, "Nom de l'actif" %>
      <%= form.text_field :asset_name, placeholder: "ex : Amundi Nasdaq-100 (PUST)",
            data: { asset_search_target: "input", action: "input->asset-search#search blur->asset-search#hideDelayed" },
            autocomplete: "off" %>
      <p class="field-hint">Tapez au moins 2 caractères pour rechercher un ETF ou une action via Yahoo Finance.</p>
      <div class="asset-search__results" data-asset-search-target="results" hidden></div>
    </div>

    <div class="field">
      <%= form.label :ticker, "Ticker" %>
      <%= form.text_field :ticker, placeholder: "ex : ESE.PA", data: { asset_search_target: "ticker" } %>
      <p class="field-hint">Optionnel, sauf pour la source automatique — format Yahoo Finance (ex : ESE.PA pour Euronext Paris). Rempli automatiquement si vous choisissez un résultat ci-dessus.</p>
    </div>

    <div class="field">
      <%= form.label :benchmark_name, "Indice de référence" %>
      <%= form.text_field :benchmark_name, placeholder: "ex : Nasdaq 100" %>
      <p class="field-hint">Optionnel — l'indice que cette ligne est censée suivre.</p>
    </div>

    <div class="field">
      <%= form.label :asset_class, "Classe d'actif" %>
      <%= form.text_field :asset_class, list: "asset-class-suggestions", placeholder: "ex : actions",
            data: { asset_search_target: "assetClass" } %>
      <datalist id="asset-class-suggestions">
        <option value="actions"></option>
        <option value="obligations"></option>
        <option value="monétaire"></option>
        <option value="immobilier"></option>
        <option value="matières premières"></option>
      </datalist>
      <p class="field-hint">Optionnel — pré-rempli automatiquement si vous choisissez un résultat de recherche ci-dessus, à vérifier.</p>
    </div>
  </div>

  <div class="field">
    <%= form.label :ter_pct, "Frais de gestion annuels — TER (%)" %>
    <%= form.number_field :ter_pct, step: 0.01, min: 0, placeholder: "ex : 0.20" %>
    <p class="field-hint">Optionnel.</p>
  </div>

  <div class="field">
    <%= form.label :data_source, "Source de la variation mensuelle" %>
    <%= form.select :data_source, [ [ "Saisie manuelle", "manual" ], [ "Automatique (Yahoo Finance)", "auto" ] ] %>
    <p class="field-hint">En automatique, la variation de l'indice est récupérée via le ticker à chaque nouvelle entrée — modifiable si besoin.</p>
  </div>

  <div class="field field--checkbox">
    <label>
      <%= form.check_box :auto_dca %>
      Générer automatiquement l'entrée du mois
    </label>
    <p class="field-hint">Nécessite la source automatique. Le montant prévu est repris du dernier mois ; vous confirmez ensuite le versement.</p>
  </div>

  <details class="field-group" <%= "open" if position.initial_capital.to_f.nonzero? || position.initial_contribution.to_f.nonzero? %>>
    <summary>J'avais déjà du capital investi sur cette ligne</summary>

    <div class="field">
      <%= form.label :initial_capital, "Capital initial (€)" %>
      <%= form.number_field :initial_capital, step: 0.01, min: 0 %>
      <p class="field-hint">Ce que ça vaut aujourd'hui, avant le premier mois suivi ici.</p>
    </div>

    <div class="field">
      <%= form.label :initial_contribution, "Apport initial (€)" %>
      <%= form.number_field :initial_contribution, step: 0.01, min: 0 %>
      <p class="field-hint">Ce que vous avez versé au total, avant le premier mois suivi ici.</p>
    </div>
  </details>

  <div class="form-actions">
    <%= form.submit "Enregistrer", class: "btn" %>
    <%= link_to "Annuler", portfolio_path(portfolio), class: "btn btn--secondary" %>
  </div>
<% end %>
