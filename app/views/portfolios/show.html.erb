<% content_for :title, @portfolio.name %>

<p><%= link_to "← Portefeuilles", portfolios_path %></p>

<div class="page-header">
  <div>
    <h1><%= @portfolio.name %></h1>
    <p class="text-muted">
      <%= @portfolio.account_type %>
      <% if @portfolio.opening_date %>
        · ouvert le <%= @portfolio.opening_date.strftime("%d/%m/%Y") %>
      <% end %>
    </p>
  </div>
  <%= link_to "Modifier", edit_portfolio_path(@portfolio), class: "btn btn--secondary" %>
</div>

<div class="page-header">
  <h2>Positions</h2>
  <%= link_to "Nouvelle position", new_portfolio_position_path(@portfolio), class: "btn" %>
</div>

<% if @positions.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Actif</th>
        <th>Indice</th>
        <th>Classe d'actif</th>
        <th class="numeric">TER</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @positions.each do |position| %>
        <tr>
          <td><%= link_to position.asset_name, portfolio_position_path(@portfolio, position) %></td>
          <td><%= position.benchmark_name.presence || "—" %></td>
          <td><%= position.asset_class.presence || "—" %></td>
          <td class="numeric"><%= position.ter_pct.present? ? number_to_percentage(position.ter_pct, precision: 2) : "—" %></td>
          <td>
            <%= link_to "Modifier", edit_portfolio_position_path(@portfolio, position) %>
            <%= link_to "Supprimer", portfolio_position_path(@portfolio, position), data: {
              turbo_method: :delete,
              turbo_confirm: "Supprimer la position « #{position.asset_name} » et tout son historique mensuel ?"
            } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <p>Aucune position dans ce portefeuille pour l'instant.</p>
    <%= link_to "Ajouter une position", new_portfolio_position_path(@portfolio), class: "btn" %>
  </div>
<% end %>
