<% content_for :title, "Mon compte" %>

<h1>Mon compte</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="field">
    <%= f.label :password, "Nouveau mot de passe" %>
    <p class="field-hint">
      Laisser vide pour ne pas le changer
      <% if @minimum_password_length %>
        (<%= @minimum_password_length %> caractères minimum)
      <% end %>
    </p>
    <%= f.password_field :password, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "Confirmation du nouveau mot de passe" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :current_password, "Mot de passe actuel" %>
    <p class="field-hint">Nécessaire pour confirmer vos changements</p>
    <%= f.password_field :current_password, autocomplete: "current-password" %>
  </div>

  <div class="form-actions">
    <%= f.submit "Mettre à jour", class: "btn" %>
  </div>
<% end %>

<h2>Supprimer mon compte</h2>

<p>
  <%= button_to "Supprimer mon compte", registration_path(resource_name),
        data: { turbo_confirm: "Êtes-vous sûr ? Cette action est irréversible." },
        method: :delete, class: "btn btn--danger" %>
</p>

<%= link_to "Retour", request.referer || root_path %>
